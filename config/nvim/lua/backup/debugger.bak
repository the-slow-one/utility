-- =============================================================================
-- dap.lua — Debug Adapter Protocol configuration for Neovim
-- Compatible with: lazy.nvim plugin manager
-- Covers: nvim-dap, nvim-dap-ui, nvim-dap-virtual-text, codelldb
--
-- ─── EXTERNAL DEPENDENCIES (install these BEFORE sourcing this file) ──────────
--
--  1. codelldb  (the debug adapter binary)
--     Download the latest release for your platform from:
--       https://github.com/vadimcn/codelldb/releases
--     Look for the asset named  codelldb-<arch>-<os>.vsix  (it is a ZIP file).
--
--     Quick install on Linux / macOS (adjust the URL to the latest version):
--
--       CODELLDB_VERSION="1.11.2"
--       INSTALL_DIR="$HOME/.local/share/codelldb"
--
--       # Linux x86_64:
--       curl -L -o /tmp/codelldb.vsix \
--         "https://github.com/vadimcn/codelldb/releases/download/v${CODELLDB_VERSION}/codelldb-x86_64-linux.vsix"
--
--       # macOS arm64 (Apple Silicon):
--       curl -L -o /tmp/codelldb.vsix \
--         "https://github.com/vadimcn/codelldb/releases/download/v${CODELLDB_VERSION}/codelldb-aarch64-darwin.vsix"
--
--       mkdir -p "$INSTALL_DIR"
--       unzip -o /tmp/codelldb.vsix -d "$INSTALL_DIR"
--       # The adapter binary will be at:
--       #   $HOME/.local/share/codelldb/extension/adapter/codelldb
--
--     On Arch Linux you can also install via AUR:
--       yay -S codelldb-bin
--       # Binary will be at /usr/bin/codelldb (symlink into /usr/lib/codelldb/)
--
--  2. A C / C++ / Rust compiler with debug symbols
--     • clang / clang++  (recommended; pairs naturally with LLDB)
--     • gcc / g++        (pass -ggdb when compiling)
--     • rustc / cargo    (debug builds include symbols by default)
--
--  3. A Nerd Font (optional but recommended for nvim-dap-ui icons)
--     https://www.nerdfonts.com/
--
-- =============================================================================

-- ─── Path to the codelldb adapter ────────────────────────────────────────────
-- Adjust CODELLDB_PATH to wherever you extracted the .vsix archive.
-- The helper below checks a few common locations so you only need to set
-- it once in your environment if you want to override the default.
local function get_codelldb_path()
  -- 1. Honour an explicit environment variable:  export CODELLDB_PATH=/path/to/codelldb
  local env = vim.env.CODELLDB_PATH
  if env and vim.fn.executable(env) == 1 then
    return env
  end

  -- 2. Manual extraction under ~/.local/share/codelldb  (recommended default)
  local default = vim.fn.expand("~/.local/share/codelldb/extension/adapter/codelldb")
  if vim.fn.executable(default) == 1 then
    return default
  end

  -- 3. Arch Linux AUR package puts a symlink at /usr/bin/codelldb
  if vim.fn.executable("codelldb") == 1 then
    return "codelldb"
  end

  -- 4. Not found — return nil so we can warn the user at startup
  return nil
end

-- =============================================================================
-- lazy.nvim plugin specifications
-- Put this file (or require it) inside your  lua/plugins/  directory.
-- =============================================================================
return {

  -- ── 1. nvim-dap (core DAP client) ──────────────────────────────────────────
  {
    "mfussenegger/nvim-dap",
    -- Lazy-load: only initialise when one of these commands / keys is used
    keys = {
      "<F5>", "<F10>", "<F11>", "<F12>",
      "<leader>db", "<leader>dB", "<leader>dc",
      "<leader>di", "<leader>do", "<leader>dO",
      "<leader>dl", "<leader>dr", "<leader>dC",
      "<leader>de", "<leader>dx",
    },
    dependencies = {
      -- nvim-dap-ui  (must be listed here so it loads alongside nvim-dap)
      "rcarriga/nvim-dap-ui",
      -- nvim-nio is a required dependency of nvim-dap-ui
      "nvim-neotest/nvim-nio",
      -- Inline variable values while stepping through code (optional but nice)
      "theHamsta/nvim-dap-virtual-text",
    },

    config = function()
      local dap    = require("dap")
      local dapui  = require("dapui")

      -- ── nvim-dap-virtual-text ───────────────────────────────────────────
      require("nvim-dap-virtual-text").setup({
        enabled                     = true,
        enabled_commands            = true, -- create commands DapVirtualTextEnable/Disable/Toggle
        highlight_changed_variables = true,
        highlight_new_as_changed    = false,
        show_stop_reason            = true,
        commented                   = false, -- prefix virtual text with comment string
        only_first_definition       = true,
        all_references              = false,
        display_callback = function(variable, _buf, _stackframe, _node, _options)
          -- Show "name = value", truncated to 70 chars to avoid line wrapping
          local val = variable.value
          if #val > 70 then val = val:sub(1, 67) .. "..." end
          return " " .. variable.name .. " = " .. val
        end,
      })

      -- ── nvim-dap-ui setup ───────────────────────────────────────────────
      dapui.setup({})

      -- ── Auto-open / auto-close the UI with the debug session ───────────
      dap.listeners.before.attach.dapui_config     = function() dapui.open() end
      dap.listeners.before.launch.dapui_config     = function() dapui.open() end
      dap.listeners.before.event_terminated.dapui_config = function() dapui.close() end
      dap.listeners.before.event_exited.dapui_config     = function() dapui.close() end

      -- ── codelldb adapter ────────────────────────────────────────────────
      local codelldb_cmd = get_codelldb_path()

      if codelldb_cmd then
        dap.adapters.codelldb = {
          type = "executable",
          command = codelldb_cmd,
          -- On Windows you may need: detached = false
        }
      else
        -- Warn the user once on startup rather than silently failing
        vim.notify(
          "[nvim-dap] codelldb not found.\n"
            .. "Install it from https://github.com/vadimcn/codelldb/releases\n"
            .. "then set the CODELLDB_PATH env variable or extract to\n"
            .. "~/.local/share/codelldb/",
          vim.log.levels.WARN,
          { title = "nvim-dap" }
        )
      end

      -- ── Debug configurations ────────────────────────────────────────────
      -- A helper that asks the user to pick or type an executable path.
      -- Falls back to the most recently built binary in common output dirs.
      local pickers = require("telescope.pickers")
      local finders = require("telescope.finders")
      local conf = require("telescope.config").values
      local actions = require("telescope.actions")
      local action_state = require("telescope.actions.state")
      local function pick_executable()
        return coroutine.create(function(coro)
            local opts = {}
            pickers
            .new(opts, {
                prompt_title = "Path to executable",
                finder = finders.new_oneshot_job({ "fd", "--hidden", "--no-ignore", "--type", "x" }, {}),
                sorter = conf.generic_sorter(opts),
                attach_mappings = function(buffer_number)
                actions.select_default:replace(function()
                    actions.close(buffer_number)
                    coroutine.resume(coro, action_state.get_selected_entry()[1])
                end)
                return true
                end,
            })
            :find()
        end)
      end

      -- C
      dap.configurations.c = {
        {
          name    = "Launch (C)",
          type    = "codelldb",
          request = "launch",
          program = pick_executable,
          cwd     = "${workspaceFolder}",
          stopOnEntry = false,
          args    = {},
          -- Uncomment to redirect stdin from a file:
          -- stdio = { "input.txt", nil, nil },
        },
        {
          name    = "Attach to process (C)",
          type    = "codelldb",
          request = "attach",
          pid     = require("dap.utils").pick_process,
          cwd     = "${workspaceFolder}",
        },
      }

      -- C++
      dap.configurations.cpp = vim.deepcopy(dap.configurations.c)
      for _, cfg in ipairs(dap.configurations.cpp) do
        cfg.name = cfg.name:gsub("%(C%)", "(C++)")
      end

      -- Rust
      dap.configurations.rust = {
        {
          name    = "Launch (Rust)",
          type    = "codelldb",
          request = "launch",
          program = pick_executable,
          cwd     = "${workspaceFolder}",
          stopOnEntry = false,
          args    = {},
          -- codelldb understands Rust types natively; use "native" expressions
          -- for richer variable display in the UI.
          expressions = "native",
          -- cargo = { args = { "build" } },   -- uncomment to build before debugging
        },
        {
          name    = "Attach to process (Rust)",
          type    = "codelldb",
          request = "attach",
          pid     = require("dap.utils").pick_process,
          cwd     = "${workspaceFolder}",
        },
      }

      -- ── Keymaps ─────────────────────────────────────────────────────────
      -- Function keys — classic debugger shortcuts
      vim.keymap.set("n", "<F5>",  dap.continue,          { desc = "DAP: Continue / Start" })
      vim.keymap.set("n", "<F10>", dap.step_over,         { desc = "DAP: Step Over" })
      vim.keymap.set("n", "<F11>", dap.step_into,         { desc = "DAP: Step Into" })
      vim.keymap.set("n", "<F12>", dap.step_out,          { desc = "DAP: Step Out / Finish" })

      -- <leader>d* — extended debugger controls
      local map = function(lhs, rhs, desc)
        vim.keymap.set("n", lhs, rhs, { desc = desc })
      end

      -- Session control
      map("<leader>dc",  dap.continue,          "DAP: Continue / Start")
      map("<leader>dC",  dap.run_to_cursor,     "DAP: Run to Cursor")
      map("<leader>di",  dap.step_into,         "DAP: Step Into")
      map("<leader>do",  dap.step_over,         "DAP: Step Over")
      map("<leader>dO",  dap.step_out,          "DAP: Step Out / Finish")
      map("<leader>dl",  dap.run_last,          "DAP: Re-run Last Session")
      map("<leader>dx",  dap.terminate,         "DAP: Terminate Session")
      map("<leader>dr",  dap.restart,           "DAP: Restart Session")

      -- Breakpoints
      map("<leader>db",  dap.toggle_breakpoint, "DAP: Toggle Breakpoint")
      map("<leader>dB",  function()
        dap.set_breakpoint(vim.fn.input("Condition: "))
      end,                                       "DAP: Set Conditional Breakpoint")
      map("<leader>dL",  function()
        dap.set_breakpoint(nil, nil, vim.fn.input("Log message: "))
      end,                                       "DAP: Set Log-point")
      map("<leader>dxb", dap.clear_breakpoints,  "DAP: Clear All Breakpoints")

      -- Breakpoint list  (opens the dap-ui breakpoints element in a float)
      map("<leader>dbl", function()
        dapui.float_element("breakpoints", { enter = true })
      end,                                       "DAP: List Breakpoints")

      -- UI toggles
      map("<leader>du",  dapui.toggle,          "DAP: Toggle UI")
      map("<leader>dS",  function()
        dapui.float_element("scopes", { enter = true })
      end,                                       "DAP: Float Scopes")
      map("<leader>dR",  function()
        dapui.float_element("repl", { enter = true })
      end,                                       "DAP: Float REPL")
      map("<leader>dW",  function()
        dapui.float_element("watches", { enter = true })
      end,                                       "DAP: Float Watches")
      map("<leader>dT",  function()
        dapui.float_element("stacks", { enter = true })
      end,                                       "DAP: Float Stack Frames")

      -- Evaluate expression under cursor / selection
      map("<leader>de",  function() dapui.eval() end,  "DAP: Eval Expression")
      vim.keymap.set("v", "<leader>de", function()
        dapui.eval()
      end, { desc = "DAP: Eval Selection" })

    end, -- end config
  }, -- end nvim-dap spec

  -- ── 2. nvim-dap-ui ─────────────────────────────────────────────────────────
  --    Declared here so lazy.nvim can manage updates; the actual setup()
  --    call lives inside nvim-dap's config above.
  {
    "rcarriga/nvim-dap-ui",
    dependencies = { "nvim-neotest/nvim-nio" },
    -- lazy = true is fine; it is always loaded via nvim-dap's dependency list
  },

  -- ── 3. nvim-nio (required by nvim-dap-ui) ──────────────────────────────────
  { "nvim-neotest/nvim-nio" },

  -- ── 4. nvim-dap-virtual-text ────────────────────────────────────────────────
  {
    "theHamsta/nvim-dap-virtual-text",
    dependencies = { "mfussenegger/nvim-dap", "nvim-treesitter/nvim-treesitter" },
    -- Setup is called inside nvim-dap's config; nothing extra needed here.
  },

} -- end return
